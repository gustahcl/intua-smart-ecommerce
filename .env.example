# Copie para .env.local e preencha. Nunca commite o .env.local.
# Tudo aqui tem plano gratuito. Ordem de uso: Groq -> Gemini -> modo demonstração.
# Sem nenhuma chave, o app roda em "modo demonstração" (roteiro de regras, sem IA).

# Groq (grátis): crie a chave em https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (grátis, reserva): crie a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
